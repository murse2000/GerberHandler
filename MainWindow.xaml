<Window x:Class="GerberHandler.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GerberHandler"
        Title="GerberHandler" Width="1350" Height="820" MinWidth="940" MinHeight="610" Icon="Assets/GerberHandler.ico"
        Background="#e9ece9" FontFamily="Malgun Gothic" AllowDrop="True"
        DragOver="WindowDragOver" Drop="WindowDrop" Closing="WindowClosing" Loaded="WindowLoaded">
    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="#f5f6f3">
            <MenuItem Header="파일(_F)">
                <MenuItem Header="Gerber ZIP 열기" Click="OpenZip" />
                <MenuItem Header="Gerber 폴더 열기" Click="OpenFolder" />
                <MenuItem Header="혼합 패널에 ZIP 추가" Click="AddBoardZips" />
                <MenuItem Header="혼합 패널에 폴더 추가" Click="AddBoardFolder" />
                <MenuItem Header="입력 파일 역할 지정" Click="MapLayers" />
                <Separator />
                <MenuItem Header="프로젝트 열기" Click="OpenProject" />
                <MenuItem Header="프로젝트 저장" Click="SaveProject" />
                <MenuItem Header="원본 교체" Click="ReplaceSource" />
                <Separator />
                <MenuItem Header="저장한 패널 ZIP 검토" Click="ReviewZip" />
            </MenuItem>
            <MenuItem Header="설정(_S)">
                <MenuItem Header="레이어 색상" Click="EditLayerColors" />
            </MenuItem>
            <MenuItem Header="도움말(_H)">
                <MenuItem Header="업데이트 확인" Click="CheckForUpdates" />
            </MenuItem>
        </Menu>
        <Border DockPanel.Dock="Top" Background="#173833" Padding="16,9">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Gerber 열기" Click="OpenZip" />
                    <Button Content="다른 보드 추가" Click="AddBoardZips" />
                    <Button Content="패널 미리보기" Click="BuildPanel" />
                    <Button Content="제조 ZIP 저장" Click="SavePanel" Background="#b8dfa8" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="GerberHandler" Foreground="#ffffff" FontWeight="Bold" FontSize="20" />
                    <TextBlock x:Name="SourceLabel" Text="Gerber ZIP 또는 폴더를 끌어 놓으세요" Foreground="#cae0d3" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Padding="12,6" Background="#dbe5dd">
            <TextBlock x:Name="StatusLabel" Text="파일을 열면 레이어와 드릴 목록이 표시됩니다." TextWrapping="Wrap" />
        </Border>
        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" MinWidth="150" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0" Background="#f5f6f3" Margin="0,0,8,0" LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="10,8">
                    <TextBlock Text="레이어" FontSize="16" FontWeight="Bold" />
                    <WrapPanel Margin="0,4,0,0">
                        <Button Content="원본" Click="ShowSource" />
                        <Button Content="저장본" Click="ShowExport" />
                    </WrapPanel>
                    <WrapPanel>
                        <Button Content="전체 표시" Click="ShowAllLayers" Padding="7,3" />
                        <Button Content="전체 숨기기" Click="HideAllLayers" Padding="7,3" />
                    </WrapPanel>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="LayerList" Margin="10,0,8,10" />
                </ScrollViewer>
            </DockPanel>
            <DockPanel Grid.Column="1" Background="#f5f6f3" LastChildFill="True">
                <TextBlock x:Name="ViewLabel" DockPanel.Dock="Top" Text="패널 작업 영역" FontWeight="Bold" Margin="10,7" />
                <local:PanelView x:Name="Viewer" />
            </DockPanel>
            <ScrollViewer Grid.Column="2" Margin="8,0,0,0" Background="#f5f6f3" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12,7">
                    <StackPanel x:Name="MixedControls" Visibility="Collapsed">
                        <TextBlock Text="혼합 배치" FontSize="16" FontWeight="Bold" />
                        <ListBox x:Name="MixedBoardList" DisplayMemberPath="Caption" SelectionChanged="MixedSelectionChanged" MaxHeight="120" />
                        <WrapPanel>
                            <Button Content="자동 배치" Click="AutoArrangeMixed" />
                            <Button Content="가로로 정렬" Click="ArrangeMixedHorizontal" />
                            <Button Content="세로로 정렬" Click="ArrangeMixedVertical" />
                            <Button Content="시계 방향 90°" Click="RotateMixedBoard" />
                            <Button Content="선택 보드 제거" Click="RemoveMixedBoard" />
                        </WrapPanel>
                        <DockPanel Margin="0,0,0,5">
                            <TextBox x:Name="MixedGap" Text="5" Width="48" DockPanel.Dock="Right" />
                            <TextBlock Text="자동 정렬 간격 (mm)" VerticalAlignment="Center" />
                        </DockPanel>
                        <CheckBox x:Name="MapOuterCopper" Content="2층 보드를 4층 패널의 외층에 배치" Click="RoutingModeChanged" Margin="0,0,0,5" />
                        <TextBlock Text="2D에서 보드를 클릭해 선택하고 끌어서 옮기세요." TextWrapping="Wrap" Margin="0,0,0,6" />
                        <Separator />
                    </StackPanel>
                    <TextBlock Text="배열과 레일" FontSize="16" FontWeight="Bold" />
                    <UniformGrid Columns="2" Margin="0,5">
                        <StackPanel x:Name="SingleRows" Margin="0,0,8,0"><TextBlock Text="행 (Y)" /><TextBox x:Name="Rows" Text="1" /></StackPanel>
                        <StackPanel x:Name="SingleColumns"><TextBlock Text="열 (X)" /><TextBox x:Name="Columns" Text="1" /></StackPanel>
                        <StackPanel x:Name="SingleRowGap" Margin="0,0,8,0"><TextBlock Text="행 간격 (mm)" /><TextBox x:Name="RowGap" Text="0" /></StackPanel>
                        <StackPanel x:Name="SingleColumnGap"><TextBlock Text="열 간격 (mm)" /><TextBox x:Name="ColumnGap" Text="0" /></StackPanel>
                        <StackPanel Margin="0,0,8,0"><CheckBox x:Name="EnableLeftRail" Content="왼쪽 레일 (mm)" IsChecked="True" /><TextBox x:Name="RailLeft" Text="5" IsEnabled="{Binding IsChecked, ElementName=EnableLeftRail}" /></StackPanel>
                        <StackPanel><CheckBox x:Name="EnableRightRail" Content="오른쪽 레일 (mm)" IsChecked="True" /><TextBox x:Name="RailRight" Text="5" IsEnabled="{Binding IsChecked, ElementName=EnableRightRail}" /></StackPanel>
                        <StackPanel Margin="0,0,8,0"><CheckBox x:Name="EnableBottomRail" Content="아래 레일 (mm)" IsChecked="True" /><TextBox x:Name="RailBottom" Text="5" IsEnabled="{Binding IsChecked, ElementName=EnableBottomRail}" /></StackPanel>
                        <StackPanel><CheckBox x:Name="EnableTopRail" Content="위 레일 (mm)" IsChecked="True" /><TextBox x:Name="RailTop" Text="5" IsEnabled="{Binding IsChecked, ElementName=EnableTopRail}" /></StackPanel>
                    </UniformGrid>
                    <CheckBox x:Name="FillGaps" Content="간격을 빈 PCB로 채우기" Margin="0,0,0,5">
                        <CheckBox.Style>
                            <Style TargetType="CheckBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=TabRouting}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </CheckBox.Style>
                    </CheckBox>
                    <TextBlock Text="커넥터 등 부품이 돌출되면 필요한 간격을 입력하세요." TextWrapping="Wrap" Margin="0,0,0,5" />
                    <CheckBox x:Name="TabRouting" Content="탭 라우팅 + 마우스바이트" Margin="0,2,0,5" Click="RoutingModeChanged" />
                    <UniformGrid Columns="2" Margin="0,0,0,6" IsEnabled="{Binding IsChecked, ElementName=TabRouting}">
                        <StackPanel Margin="0,0,8,0"><TextBlock Text="보드–레일 간격 (mm)" /><TextBox x:Name="RailChannel" Text="3" /></StackPanel>
                        <StackPanel><TextBlock Text="라우터 지름 (mm)" /><TextBox x:Name="CutterDiameter" Text="2" /></StackPanel>
                        <StackPanel Margin="0,0,8,0"><TextBlock Text="탭 폭 (mm)" /><TextBox x:Name="TabWidth" Text="5" /></StackPanel>
                        <StackPanel><TextBlock Text="변당 탭 수" /><TextBox x:Name="TabsPerEdge" Text="2" /></StackPanel>
                        <StackPanel Margin="0,0,8,0"><TextBlock Text="타공 지름 (mm)" /><TextBox x:Name="BiteDiameter" Text="0.5" /></StackPanel>
                        <StackPanel><TextBlock Text="타공 피치 (mm)" /><TextBox x:Name="BitePitch" Text="0.9" /></StackPanel>
                    </UniformGrid>
                    <Separator />
                    <TextBlock Text="조립용 마크" FontWeight="Bold" FontSize="16" />
                    <CheckBox x:Name="Fiducials" Content="상면 피두셜" IsChecked="True" Margin="0,8,0,3" />
                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,8,0"><TextBlock Text="동박 지름 (mm)" /><TextBox x:Name="FiducialDiameter" Text="1" /></StackPanel>
                        <StackPanel><TextBlock Text="개구 지름 (mm)" /><TextBox x:Name="MaskDiameter" Text="2" /></StackPanel>
                    </UniformGrid>
                    <CheckBox x:Name="Tooling" Content="비도금 고정 홀" Margin="0,7,0,3" />
                    <TextBlock Text="고정 홀 지름 (mm)" />
                    <TextBox x:Name="ToolingDiameter" Text="2" />
                    <Expander Header="마크 좌표 직접 지정" Margin="0,6">
                        <StackPanel>
                            <TextBlock Text="2D에서 피두셜을 끌면 1 mm씩 이동합니다. 좌표를 직접 입력하려면 한 줄에 X Y를 쓰세요. 빈 경우 자동 배치합니다." TextWrapping="Wrap" />
                            <TextBlock Text="피두셜 좌표" Margin="0,5,0,0" />
                            <TextBox x:Name="FiducialPositions" AcceptsReturn="True" Height="55" VerticalScrollBarVisibility="Auto" />
                            <TextBlock Text="고정 홀 좌표" />
                            <TextBox x:Name="ToolingPositions" AcceptsReturn="True" Height="55" VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                    </Expander>
                    <Separator />
                    <TextBlock Text="제조·조립 조건" FontSize="16" FontWeight="Bold" />
                    <DockPanel Margin="0,5">
                        <Button DockPanel.Dock="Right" Content="등록" Click="CreatePreset" Margin="5,0,0,0" />
                        <ComboBox x:Name="Presets" DisplayMemberPath="Name" SelectionChanged="PresetChanged" />
                    </DockPanel>
                    <TextBlock x:Name="PresetLabel" Text="제조 ZIP을 저장하려면 확인한 제조 조건을 선택하세요." TextWrapping="Wrap" />
                    <Separator Margin="0,8,0,3" />
                    <TextBlock Text="저장본 비교" FontSize="16" FontWeight="Bold" />
                    <WrapPanel x:Name="CompareControls" Margin="0,5,0,0">
                        <ComboBox x:Name="Cells" MinWidth="122" Margin="0,3,6,3" />
                        <Button Content="원본과 비교" Click="CompareCell" />
                    </WrapPanel>
                    <ListBox x:Name="Findings" MaxHeight="160" SelectionChanged="FindingSelected" DisplayMemberPath="Text" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
