<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.2.1</Version>
    <Product>GerberHandler</Product>
    <AssemblyName>GerberHandler</AssemblyName>
    <StartupObject>GerberHandler.Program</StartupObject>
    <ApplicationIcon>Assets/GerberHandler.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
    <PackageReference Include="Clipper2" Version="2.0.0" />
    <Resource Include="Assets/GerberHandler.ico" />
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>
</Project>
